{
	"name": "agents-build-background",
	"displayName": "Agents Build Background",
	"description": "Manually updates the Agents build background from the Command Palette.",
	"version": "0.0.1",
	"publisher": "aamunger-local",
	"engines": {
		"vscode": "^1.100.0"
	},
	"extensionKind": [
		"ui"
	],
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished",
		"onCommand:agentsBuildBackground.update"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "agentsBuildBackground.update",
				"title": "Update Agents Build Background",
				"category": "Agents"
			}
		]
	}
}
